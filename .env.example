PORT=5000
NODE_ENV=development

# Local Mongo, or paste your MongoDB Atlas connection string here
MONGO_URI=mongodb://127.0.0.1:27017/starter_hackathon

# POSTGRES: remove MONGO_URI above and use this instead.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Create the "starter_hackathon" database in pgAdmin first
# (Servers > PostgreSQL > Databases > right click > Create > Database).
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/starter_hackathon

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
